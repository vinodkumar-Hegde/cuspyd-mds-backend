# EXAMPLE image locations; build/publish these in your chosen registry first.
# Use an immutable commit tag or sha256 digest, and keep the previous release pair.
BACKEND_IMAGE=ghcr.io/vinodkumar-hegde/cuspyd-mds-backend:REPLACE_WITH_COMMIT_SHA
FRONTEND_IMAGE=ghcr.io/vinodkumar-hegde/cuspyd-mds-frontend:REPLACE_WITH_COMMIT_SHA
# Absolute paths on the deployment host; generated by your secret manager.
RUNTIME_ENV_FILE=/etc/mdslate/runtime.env
MIGRATION_ENV_FILE=/etc/mdslate/migrate.env
# Database provider's trusted CA bundle, mounted read-only in both API jobs.
DB_CA_FILE=/etc/mdslate/db-ca.pem
# TLS ingress forwards to this loopback listener. Configure its real-IP chain.
HTTP_BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
PROXY_NETWORK_CIDR=10.211.24.0/24
FRONTEND_PROXY_IP=10.211.24.10
# Exact CIDR of the TLS ingress peer observed by Nginx; never 0.0.0.0/0.
# Safe loopback default ignores unsolicited forwarded headers.
TRUSTED_INGRESS_CIDR=127.0.0.1/32
