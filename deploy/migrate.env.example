# Database OWNER/DDL role, distinct from the API's runtime role.
DATABASE_URL=postgresql+psycopg://MIGRATION_USER:URL_ENCODED_PASSWORD@DB_HOST:5432/mdslate?sslmode=verify-full&sslrootcert=/run/secrets/db-ca.pem
# Required by shared configuration; migrations do not issue JWTs.
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
APP_ENV=production
# Must match runtime normalization for national-format legacy numbers.
PHONE_DEFAULT_REGION=IN
