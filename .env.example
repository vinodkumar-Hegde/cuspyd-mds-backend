# API runtime configuration. Generate real secrets outside Git.
# URL-encode credentials; install the database provider's CA for verify-full TLS.
DATABASE_URL=postgresql+psycopg://RUNTIME_USER:URL_ENCODED_PASSWORD@DB_HOST:5432/mdslate?sslmode=verify-full&sslrootcert=/run/secrets/db-ca.pem
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
OTP_SECRET=REPLACE_WITH_A_DIFFERENT_32_CHARACTER_RANDOM_SECRET
CORS_ORIGIN=https://app.example.com
APP_ENV=production
PHONE_DEFAULT_REGION=IN
ACCESS_TOKEN_MINUTES=60
EXAM_SECONDS_PER_QUESTION=60
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_BYTES=10485760
STORAGE_BACKEND=local
# To use S3: set STORAGE_BACKEND=s3, bucket and region; attach workload IAM.
S3_BUCKET=
S3_PREFIX=uploads
# Overrides AWS_REGION for storage when SES and S3 use different regions.
S3_REGION=
S3_PRESIGN_SECONDS=300
# Optional explicit SSE-KMS key; blank uses the bucket's default encryption.
S3_KMS_KEY_ID=
# Uvicorn: replace with actual trusted proxy IPs/CIDRs; never trust arbitrary peers.
# Configure the ingress/Nginx real-IP chain as described in docs/DEVOPS_HANDOFF.md.
FORWARDED_ALLOW_IPS=127.0.0.1
OTP_EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SES_FROM_EMAIL=
AWS_REGION=ap-south-1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# SES uses the AWS SDK default credential chain; attach a workload IAM role.
# See docs/INTEGRATIONS.md for S3 permissions and existing-file migration.
