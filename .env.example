POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
OTP_SECRET=REPLACE_WITH_A_DIFFERENT_32_CHARACTER_RANDOM_SECRET
CORS_ORIGIN=http://localhost:3000
APP_ENV=development
PHONE_DEFAULT_REGION=IN
ACCESS_TOKEN_MINUTES=60
EXAM_SECONDS_PER_QUESTION=60
OTP_EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SES_FROM_EMAIL=
AWS_REGION=ap-south-1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional sender-credential file used by docker-compose.ses-sso.yml.
SES_ENV_FILE=

DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
